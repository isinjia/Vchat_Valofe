# ===== 공통 =====
# Claude API 키 (https://platform.claude.com)
ANTHROPIC_API_KEY=

# ===== MySQL (설정/유저/세계관/캐릭터 메타) =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=vchatbot
MYSQL_PASSWORD=vchatbot
MYSQL_DATABASE=vchatbot

# ===== MongoDB (채팅 로그) =====
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=vchatbot

# ===== Redis (세션 컨텍스트 캐시) =====
REDIS_URL=redis://127.0.0.1:6379

# ===== 포트 =====
# web: 개발 3000, 운영은 리버스프록시(nginx 등)가 80/443 -> 3000 으로 전달
# admin: 5001

# ===== 인증 (vfun KR) =====
APP_ENV=dev            # dev | stage | live (dev 는 stage 인증서버 사용)
SESSION_SECRET=dev-secret-change-me

# ===== 개발 자동 로그인 (로컬 전용, web + admin 공통) =====
# users.id 를 넣으면 개발 서버(next dev)에서 vfun 로그인 없이 그 계정으로 로그인된 것으로 본다 (관리툴은 system_admin 세션 자동 발급).
# production 빌드에서는 무시된다. 비워 두면 평소처럼 vfun 로그인 필요.
DEV_AUTO_LOGIN_UID=

# ===== 하루 목소리 (방송 페이지 /haru) =====
# 하루 음성 서버(지피티 소비츠, 방송하는 컴퓨터에서 따로 실행) 주소와 말투 기준 음성.
# 비워 두면 하루는 목소리 없이 입만 움직인다.
HARU_TTS_URL=http://127.0.0.1:9880
HARU_TTS_REF=
HARU_TTS_REF_TEXT=
# 말 빠르기 (1 = 학습 그대로, 기본 1. 1 아래는 발음이 뭉개진다)
HARU_TTS_SPEED=
# 문장 끝말별 기준 음성 표(json 경로, 비우면 위 기준 음성만)
HARU_TTS_REF_MAP=
