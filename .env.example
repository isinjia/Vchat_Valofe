# ===== 공통 =====
# Claude API 키 (https://platform.claude.com)
ANTHROPIC_API_KEY=

# ===== MySQL (설정/유저/세계관/캐릭터 메타) =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=vchatbot
MYSQL_PASSWORD=vchatbot
MYSQL_DATABASE=vchatbot

# ===== MongoDB (채팅 로그) =====
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=vchatbot

# ===== Redis (세션 컨텍스트 캐시) =====
REDIS_URL=redis://127.0.0.1:6379

# ===== 포트 =====
# web: 개발 3000, 운영은 리버스프록시(nginx 등)가 80/443 -> 3000 으로 전달
# admin: 5001
