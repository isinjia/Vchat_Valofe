# 스테이지 데몬 머신용 환경 변수 — 레포 루트에 .env.stage 로 복사 후 값 채우기
# (compose 가 --env-file 로 읽고, 컨테이너에도 env_file 로 그대로 주입된다)

ANTHROPIC_API_KEY=

# ===== DB 머신 (MySQL/Mongo/Redis 직접 설치) =====
MYSQL_HOST=<DB머신 내부IP>
MYSQL_PORT=3306
MYSQL_USER=vchatbot
MYSQL_PASSWORD=<restore-mysql.sh 에서 지정한 비밀번호>
MYSQL_DATABASE=vchatbot

MONGODB_URI=mongodb://<DB머신 내부IP>:27017
MONGODB_DB=vchatbot

# requirepass 를 설정했으면 redis://:<비밀번호>@<DB머신 내부IP>:6379
# VMessage 등과 Redis 를 공유하면 DB 인덱스 분리: redis://<IP>:6379/1
REDIS_URL=redis://<DB머신 내부IP>:6379

# ===== 인증 =====
APP_ENV=stage
SESSION_SECRET=<강력한 랜덤 문자열로 교체 — 유출 시 세션 위조 가능>

# ===== 호스트 TLS 포트 (nginx 컨테이너가 TLS 종료 후 내부의 web:5000 / admin:5001 로 프록시) =====
# 원본 HTTP 포트는 호스트에 공개되지 않는다 (web 내부 포트는 혼동 방지를 위해 3000 이 아닌 5000).
# 기존 HTTP 시절 쓰던 5000/5001 을 그대로 TLS 로 승계 (주소 유지 + 방화벽 이미 개방).
# VMessage 사용 포트(4000/4002/4100/8443/8444/8080)는 피할 것 (9443 은 미사용 확인되어 queue 가 재활용).
WEB_TLS_PORT=5000
ADMIN_TLS_PORT=5001
# web 은 표준 443 으로도 접속 가능 (포트 없이 https://<도메인>) — 443 과 5000 둘 다 web 으로 간다
WEB_TLS_443_PORT=443

# ===== LLM 대기열 (사내 AI 머신의 llm-worker 가 롱폴링) =====
# 9443 은 방화벽이 이미 열려 있는 미사용 포트 재활용. 워커 쪽 QUEUE_URL 은 https://<도메인>:9443
# 배포는 별도 잡(deploy/Jenkinsfile.queue) — 메인 잡은 queue 를 건드리지 않는다.
QUEUE_TLS_PORT=9443
QUEUE_WORKER_TOKEN=<워커 인증 토큰 — AI 머신의 llm-worker 와 동일 값, 랜덤 문자열>
# 설정 시 /v1 호출(admin LLM 등록의 API Key)에 Bearer 인증 요구 — 공개 포트이므로 설정 권장
QUEUE_CLIENT_TOKEN=<클라이언트 토큰 — admin LLM 등록의 API Key 에 넣는 값>
