# LLM 대기열 데몬(services/llm-queue) — 스테이지용
# 빌드 컨텍스트는 레포 루트:  docker build -f deploy/docker/Dockerfile.queue .
# 빌드 단계 없음 — tsx 가 TS 를 바로 실행한다 (의존성도 tsx 뿐).
FROM node:22-bookworm-slim
WORKDIR /app

# 워크스페이스 메타만 먼저 복사 — Dockerfile.web/admin 과 동일한 순서라 npm ci 레이어 캐시를 공유한다
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
COPY packages/core/package.json packages/core/
COPY services/llm-queue/package.json services/llm-queue/
COPY services/llm-worker/package.json services/llm-worker/
# NODE_ENV=production 을 npm ci 전에 두면 devDependency 인 tsx 가 빠진다 — 설정하지 않음
RUN npm ci

COPY services/llm-queue ./services/llm-queue
EXPOSE 8600
CMD ["npm", "run", "start", "--workspace", "services/llm-queue"]
