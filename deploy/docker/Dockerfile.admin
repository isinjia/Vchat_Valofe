# 관리툴(apps/admin) — 스테이지용 release 빌드 (next build + next start)
# 빌드 컨텍스트는 레포 루트:  docker build -f deploy/docker/Dockerfile.admin .
FROM node:22-bookworm-slim AS builder
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
COPY packages/core/package.json packages/core/
COPY services/llm-queue/package.json services/llm-queue/
COPY services/llm-worker/package.json services/llm-worker/
RUN npm ci

COPY . .
RUN npm run build --workspace apps/admin

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /app /app
EXPOSE 5001
CMD ["npm", "run", "start", "--workspace", "apps/admin"]
