# 채팅 서버(apps/web) — 스테이지용 release 빌드 (next build + next start)
# 빌드 컨텍스트는 레포 루트:  docker build -f deploy/docker/Dockerfile.web .
# alpine 금지: @huggingface/transformers 의 onnxruntime-node 가 glibc 필요
FROM node:22-bookworm-slim AS builder
WORKDIR /app

# 워크스페이스 메타만 먼저 복사 — 소스가 바뀌어도 npm ci 레이어는 캐시된다
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/
COPY apps/admin/package.json apps/admin/
COPY packages/core/package.json packages/core/
COPY services/llm-queue/package.json services/llm-queue/
COPY services/llm-worker/package.json services/llm-worker/
RUN npm ci

COPY . .
RUN npm run build --workspace apps/web

FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder /app /app
EXPOSE 3000
CMD ["npm", "run", "start", "--workspace", "apps/web"]
